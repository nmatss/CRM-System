# ===========================================
# ZippiCRM - Environment Configuration
# ===========================================

# Database Configuration (SQLite)
# ---------------------------------------------
# SQLite database file path (relative or absolute)
# Default: ./data/zippcrm.db
DATABASE_PATH=./data/zippcrm.db

# Server Configuration
# ---------------------------------------------
PORT=6000
NODE_ENV=development

# Session Secret
# ---------------------------------------------
# IMPORTANT: Generate a secure random string for production!
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=your-super-secret-session-key-change-this

# Admin Credentials
# ---------------------------------------------
# REQUIRED in production! Super admin account credentials.
# These are used to create the initial super admin user.
# IMPORTANT: Change these values for production deployments!
# For security, never commit the actual .env file with real credentials.
ADMIN_EMAIL=admin@zippi.crm
ADMIN_PASSWORD=change-this-secure-password

# ===========================================
# DEPLOYMENT GUIDES
# ===========================================
#
# LOCAL DEVELOPMENT:
# 1. Copy this file to .env
# 2. Set ADMIN_EMAIL and ADMIN_PASSWORD (or leave unset to get a random password)
# 3. Run: npm run db:push (creates SQLite database)
# 4. Run: npm run dev
# 5. If ADMIN_PASSWORD was not set, check console for generated password
#
# PRODUCTION DEPLOYMENT:
# IMPORTANT: ADMIN_EMAIL and ADMIN_PASSWORD are REQUIRED in production!
# The application will fail to start if these are not set.
#
# RENDER.COM (Recommended):
# 1. Connect your GitHub repo
# 2. Click "New Blueprint" and select render.yaml
# 3. Set environment variables:
#    - NODE_ENV=production
#    - SESSION_SECRET=<generated-secret>
#    - ADMIN_EMAIL=<your-admin-email>
#    - ADMIN_PASSWORD=<secure-password>
# 4. Disk storage is automatically configured
# 5. Deploy!
#
# RAILWAY.APP:
# 1. Connect your GitHub repo
# 2. Add a volume in Railway dashboard (mount: /app/data)
# 3. Set environment variables (same as Render.com)
# 4. Deploy automatically reads railway.toml
#
# DOCKER:
# 1. Build: docker build -t zippcrm .
# 2. Run: docker run -p 6000:6000 \
#    -e NODE_ENV=production \
#    -e SESSION_SECRET=<generated-secret> \
#    -e ADMIN_EMAIL=<your-admin-email> \
#    -e ADMIN_PASSWORD=<secure-password> \
#    -v zippcrm-data:/app/data zippcrm
#
# ===========================================
# FUTURE MIGRATION TO POSTGRESQL/SUPABASE
# ===========================================
# When ready to migrate to PostgreSQL:
# 1. Export SQLite data
# 2. Change schema.ts from sqliteTable to pgTable
# 3. Change db.ts to use node-postgres
# 4. Set DATABASE_URL environment variable
# 5. Run: npm run db:push
