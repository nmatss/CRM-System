# ===========================================
# ZippiCRM - Environment Configuration
# ===========================================

# Database Configuration (SQLite)
# ---------------------------------------------
# SQLite database file path (relative or absolute)
# Default: ./data/zippcrm.db
DATABASE_PATH=./data/zippcrm.db

# Optional SQLite file for server-side sessions.
# Use a separate file in production to reduce write contention on the business DB.
SESSION_DATABASE_PATH=./data/sessions.db

# Production bootstrap guard for SQLite
# ---------------------------------------------
# Default false. In production, the app refuses to create a brand-new database
# unless this is explicitly true. Use true only during the first controlled boot
# of an empty persistent volume, then set it back to false.
ALLOW_EMPTY_DATABASE_BOOTSTRAP=false

# Server Configuration
# ---------------------------------------------
PORT=6000
NODE_ENV=development
# Optional. Set only behind a trusted reverse proxy/PaaS.
# Render/Railway commonly use TRUST_PROXY=1. Leave empty for direct Docker exposure.
TRUST_PROXY=

# Session Secret
# ---------------------------------------------
# IMPORTANT: Generate a secure random string for production!
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace-with-random-64-byte-hex-secret

# Admin Credentials
# ---------------------------------------------
# REQUIRED in production! Super admin account credentials.
# These are used to create the initial super admin user.
# IMPORTANT: Change these values for production deployments!
# For security, never commit the actual .env file with real credentials.
ADMIN_EMAIL=admin@zippi.crm
ADMIN_PASSWORD=replace-with-strong-initial-admin-password

# ===========================================
# DEPLOYMENT GUIDES
# ===========================================
#
# LOCAL DEVELOPMENT:
# 1. Copy this file to .env
# 2. Set ADMIN_EMAIL and ADMIN_PASSWORD explicitly
# 3. Run: npm run db:push (creates SQLite database)
# 4. Run: npm run dev
# 5. Without ADMIN_PASSWORD the local bootstrap is safely skipped
#
# PRODUCTION DEPLOYMENT:
# IMPORTANT: ADMIN_EMAIL and ADMIN_PASSWORD are REQUIRED in production!
# The application will fail to start if these are not set.
# SESSION_SECRET must have at least 32 characters and ADMIN_PASSWORD at least 12 characters.
# Placeholder values such as "change-this" or "password" are rejected in production.
# For the first boot of an empty SQLite volume only, set ALLOW_EMPTY_DATABASE_BOOTSTRAP=true,
# confirm /api/health and initial admin creation, then set it back to false.
#
# RENDER.COM (Recommended):
# 1. Connect your GitHub repo
# 2. Click "New Blueprint" and select render.yaml
# 3. Set environment variables:
#    - NODE_ENV=production
#    - TRUST_PROXY=1
#    - SESSION_SECRET=<generated-secret>
#    - ADMIN_EMAIL=<your-admin-email>
#    - ADMIN_PASSWORD=<secure-password>
# 4. Disk storage requires a paid Render plan; render.yaml uses plan: starter
# 5. For first deploy on an empty disk, temporarily set ALLOW_EMPTY_DATABASE_BOOTSTRAP=true
# 6. Deploy, validate /api/health, then set ALLOW_EMPTY_DATABASE_BOOTSTRAP=false
#
# RAILWAY.APP:
# 1. Connect your GitHub repo
# 2. Add a volume in Railway dashboard (mount: /app/data)
# 3. Set environment variables (same as Render.com)
# 4. Set ALLOW_EMPTY_DATABASE_BOOTSTRAP=true only for first empty-volume boot
# 5. Deploy automatically reads railway.toml and fails fast if the volume is not mounted at /app/data
#
# DOCKER:
# 1. Build: docker build -t zippcrm .
# 2. Run: docker run -p 6000:6000 \
#    -e NODE_ENV=production \
#    -e SESSION_SECRET=<generated-secret> \
#    -e ADMIN_EMAIL=<your-admin-email> \
#    -e ADMIN_PASSWORD=<secure-password> \
#    -e ALLOW_EMPTY_DATABASE_BOOTSTRAP=true \
#    -v zippcrm-data:/app/data zippcrm
#
# ===========================================
# DELIVERY PROVIDERS AND OUTBOX WORKER
# ===========================================
# A channel is only usable when its provider variable is set. While unset, the
# adapter fails closed: campaign and automation executions are recorded as
# "not_configured" and nothing is sent. Never store credentials anywhere else.
# EMAIL_PROVIDER=
# SMS_PROVIDER=
# WHATSAPP_PROVIDER=
#
# The embedded outbox worker runs inside the API process. Set to false to stop
# claiming jobs (for maintenance); queued jobs stay persisted and resume later.
# OUTBOX_WORKER_ENABLED=true

# ===========================================
# FUTURE MIGRATION TO POSTGRESQL/SUPABASE
# ===========================================
# When ready to migrate to PostgreSQL:
# 1. Export SQLite data
# 2. Change schema.ts from sqliteTable to pgTable
# 3. Change db.ts to use node-postgres
# 4. Set DATABASE_URL environment variable
# 5. Run: npm run db:push
